<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card listing-card col-6 offset-3 show-card">
    <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_img">

    <div class="card-body">
      <p class="card-text">
        <br>
        <%= listing.description %><br>
        &#8377; <%= listing.price.toLocaleString("en-IN") %><br>
        <%= listing.location %><br>
        <%= listing.country %><br>
      </p>
    </div>
  </div>

  <div class="btns col-6 offset-3 mt-3">
    <a href="/listings/<%= listing._id %>/edit"
       class="btn btn-dark edit-btn">Edit</a>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=DELETE"
      class="d-inline"
    >
      <button class="btn btn-dark offset-3" >Delete</button>
    </form>
  </div>

  <div class="col-6 offset-3 mb-3">
    <hr>

    <h4>Leave a Review</h4>

    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      class="needs-validation"
      novalidate
    >

      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>

        <input
          id="rating"
          name="review[rating]"
          type="range"
          min="1"
          max="5"
          step="1"
          class="form-range"
        >
      </div>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>

        <textarea
          id="comment"
          name="review[comment]"
          cols="30"
          rows="5"
          required
          class="form-control"
        ></textarea>

        <div class="invalid-feedback">
          Please add some comments for review.
        </div>
      </div>

      <button class="btn btn-outline-dark add mt-3">
        Add Review
      </button>

    </form>

    <hr>

    <p><b>Reviews:</b></p>

    <div class="row">
      <% for(review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body " >
          <h5 class="card-title">John Doe</h5>
          <p class="card-text"><%= review.comment %></p>
          <p class="card-text">Rating: <%= review.rating %> stars</p>
        </div>
        
        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
          <button class="btn btn-sm btn-dark mt-2 mb-2">Delete</button>
        </form>
      </div>
      <% } %>
    </div>

  </div>
</div>